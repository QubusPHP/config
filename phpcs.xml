<?xml version="1.0"?>
<ruleset xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/squizlabs/php_codesniffer/phpcs.xsd">

    <arg name="basepath" value="."/>
    <arg name="cache" value=".phpcs-cache"/>
    <arg name="colors"/>
    <arg name="extensions" value="php"/>
    <arg name="parallel" value="80"/>

    <!-- Show progress -->
    <arg value="p"/>

    <!-- Paths to check -->
    <file>./Loader</file>
    <file>./Interop</file>
    <file>./Path</file>
    <file>./ArrayCollection.php</file>
    <file>./Collection.php</file>
    <file>./ConfigContainer.php</file>
    <file>./ConfigLoader.php</file>
    <file>./Configuration.php</file>
    <file>./Container.php</file>
    <file>./Factory.php</file>
    <file>./Parser.php</file>
    <file>./VariableDecorator.php</file>

    <!-- Include rules from the Qubus Coding Standard -->
    <rule ref="QubusCodingStandard"/>

    <!-- These names are part of the embedded interop-config public API. -->
    <rule ref="SlevomatCodingStandard.Classes.SuperfluousTraitNaming.SuperfluousSuffix">
        <exclude-pattern>Interop/ConfigurationTrait.php</exclude-pattern>
    </rule>
    <rule ref="SlevomatCodingStandard.Classes.SuperfluousInterfaceNaming.SuperfluousSuffix">
        <exclude-pattern>Interop/Exception/ExceptionInterface.php</exclude-pattern>
    </rule>
    <rule ref="SlevomatCodingStandard.Classes.SuperfluousAbstractClassNaming.SuperfluousPrefix">
        <exclude-pattern>Interop/Tool/AbstractCommand.php</exclude-pattern>
    </rule>
</ruleset>
