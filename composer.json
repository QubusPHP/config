{
	"name": "qubus/config",
	"description": "Package for loading, saving and accessing config settings.",
	"keywords": ["config", "configuration"],
	"homepage": "https://github.com/QubusPHP/config",
	"license": "MIT",
	"authors": [
		{
			"name": "Joshua Parker",
			"email": "joshua@joshuaparker.dev"
		}
	],
	"require": {
		"php": ">=8.4",
		"psr/container": "^2",
		"qubus/exception": "^4",
		"sandrokeil/interop-config": "^2",
		"symfony/yaml": "^8",
		"vlucas/phpdotenv": "^5"
	},
	"require-dev": {
		"qubus/qubus-coding-standard": "^2.1.2"
	},
	"autoload": {
		"psr-4": {
			"Qubus\\Config\\": ""
		},
		"files": [
			"Helpers/core.php"
		]
	},
	"autoload-dev": {
		"psr-4": {
			"Qubus\\Tests\\Config\\": "Tests/"
		}
	},
	"scripts": {
		"test": "vendor/bin/phpunit",
		"cs-check": "phpcs",
		"cs-fix": "phpcbf"
	},
	"config": {
		"optimize-autoloader": true,
		"sort-packages": true,
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"pestphp/pest-plugin": true
		}
	}
}
